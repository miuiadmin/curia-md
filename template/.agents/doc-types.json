{
  "version": 1,
  "comment": "Curia 文档类型注册表：类型系统的唯一权威来源。模板、门禁、投影文档、脚手架、按需索引全部从这里派生；改类型只改本文件，然后 node scripts/gen-doc-types.mjs 重生成投影。字段语义见 .agents/doc-types.md。",
  "projection": ".agents/doc-types.md",
  "templateDir": ".agents/templates",
  "rawMarker": ".agents-raw",
  "exemptPaths": [
    ".agents/templates/**",
    "node_modules/**",
    ".git/**",
    ".claude/**",
    ".codex/**"
  ],
  "resolutionOrder": [
    "glossary",
    "projection",
    "skill",
    "runbook",
    "readme",
    "agents-rules",
    "note",
    "frozen"
  ],
  "globalRules": {
    "statusRequiresField": {
      "superseded": "Superseded-by"
    },
    "archiveRequiresField": "Archived",
    "emptySectionMarker": "_（无）_",
    "maxFutureDays": 1,
    "headroomRatio": 0.05
  },
  "workspaceLayout": {
    "comment": "封闭集：.agents/ 顶层、仓库根目录与仓库根 Markdown 只允许这些名字，多出的一律报错（防止新目录/新门面文件绕过类型系统）。rootDirs 含点目录（.git 等）——新增任何根目录都要先登记。",
    "agentsDirs": [
      "notes",
      "skills",
      "plans",
      "research",
      "future",
      "archive",
      "templates"
    ],
    "agentsFiles": [
      "README.md",
      "GLOSSARY.md",
      "doc-types.json",
      "doc-types.md"
    ],
    "rootMarkdown": [
      "AGENTS.md",
      "README.md",
      "CLAUDE.md"
    ],
    "rootDirs": [
      ".agents",
      ".claude",
      ".codex",
      ".git",
      "scripts"
    ]
  },
  "bridges": [
    {
      "path": "CLAUDE.md",
      "target": "AGENTS.md",
      "consumer": "Claude Code"
    },
    {
      "path": ".claude/skills",
      "target": "../.agents/skills",
      "consumer": "Claude Code"
    },
    {
      "path": ".codex/skills",
      "target": "../.agents/skills",
      "consumer": "Codex"
    }
  ],
  "noteTree": {
    "comment": "笔记树（note 类型）的格式权威：lifecycle 与 class 封闭集、Status 行形态、按 lifecycle 的必备节与禁用节。check-agent-notes.mjs 消费本块——改笔记格式改这里，不改代码。节键命名空间独立于全局 sectionAliases（「## 方案」在笔记里是 proposal，在计划文档里是 steps，两边刻意不共用）。",
    "lifecycles": [
      "proposed",
      "implemented",
      "rejected"
    ],
    "classes": [
      "feature",
      "bug-fix",
      "simplification",
      "architecture",
      "process",
      "testing"
    ],
    "statusLine": {
      "proposed": "Status: proposed",
      "implemented": "Status: implemented",
      "rejected": "Status: rejected — <一行原因>"
    },
    "statusReasonRequired": [
      "rejected"
    ],
    "firstSection": "problem",
    "alternativesExemptComment": "agent-note-format: alternatives-not-recorded (retro)",
    "sectionAliases": {
      "problem": [
        "## Problem",
        "## 问题"
      ],
      "proposal": [
        "## Proposal",
        "## 提案",
        "## 方案",
        "## 提议"
      ],
      "decision": [
        "## Decision",
        "## 决定",
        "## 决策"
      ],
      "alternatives": [
        "## Alternatives considered",
        "## 备选方案",
        "## 替代方案"
      ],
      "acceptance": [
        "## Acceptance criteria",
        "## 验收标准",
        "## 验收条件",
        "## 接受标准"
      ],
      "risks": [
        "## Risks",
        "## 风险"
      ],
      "consequences": [
        "## Consequences",
        "## 后果",
        "## 影响",
        "## 结果"
      ],
      "plan": [
        "## Plan",
        "## 计划",
        "## 规划"
      ],
      "migration-plan": [
        "## Migration plan",
        "## 迁移计划"
      ]
    },
    "sectionsByStatus": {
      "proposed": [
        "problem",
        "proposal",
        "alternatives",
        "acceptance",
        "risks"
      ],
      "implemented": [
        "problem",
        "decision",
        "alternatives",
        "consequences"
      ],
      "rejected": []
    },
    "bannedSectionsByStatus": {
      "implemented": [
        "proposal",
        "plan",
        "migration-plan",
        "acceptance"
      ],
      "rejected": [
        "proposal",
        "plan",
        "migration-plan",
        "acceptance"
      ]
    }
  },
  "headerFields": {
    "Type": {
      "order": 1,
      "kind": "type-token",
      "doc": "本文件在注册表里的类型键"
    },
    "Status": {
      "order": 2,
      "kind": "status-token",
      "doc": "生命周期状态，取值受该类型 statuses 约束"
    },
    "Updated": {
      "order": 3,
      "kind": "date",
      "doc": "最近一次实质改动日（改内容就改它）"
    },
    "Verified": {
      "order": 4,
      "kind": "date",
      "doc": "最近一次按文档执行/复核并观察到预期结果的日子"
    },
    "Owner": {
      "order": 5,
      "kind": "text",
      "doc": "维护责任人或角色"
    },
    "Source": {
      "order": 6,
      "kind": "text",
      "doc": "事实来源：仓库内相对链接、URL、系统名"
    },
    "Note": {
      "order": 7,
      "kind": "link",
      "doc": "指向决策笔记（因果归属在 notes/）"
    },
    "Supersedes": {
      "order": 8,
      "kind": "link",
      "doc": "本文取代了谁"
    },
    "Superseded-by": {
      "order": 9,
      "kind": "link",
      "doc": "谁取代了本文；Status 为 superseded 时必填"
    },
    "Archived": {
      "order": 10,
      "kind": "date",
      "doc": "归档日；.agents/archive/ 下的文档必填"
    }
  },
