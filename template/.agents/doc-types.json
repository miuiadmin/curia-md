  "homes": {
    "plans": {
      "path": ".agents/plans",
      "job": "承诺要做的意图",
      "criterion": "「要做什么？做到哪了？」",
      "types": [
        "proposal",
        "spec",
        "plan"
      ]
    },
    "research": {
      "path": ".agents/research",
      "job": "已成事实与证据",
